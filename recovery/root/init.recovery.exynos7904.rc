on early-init
    write /sys/fs/selinux/enforce 0
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu5/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu6/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor performance

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "13600000.dwc3"

    # Linux 4.4 binderfs fallback compatibility
    mkdir /dev/binderfs 0755 root root
    chmod 0755 /dev/binderfs
    chmod 0666 /dev/binder
    chmod 0666 /dev/hwbinder
    chmod 0666 /dev/vndbinder
    symlink /dev/binder /dev/binderfs/binder
    symlink /dev/hwbinder /dev/binderfs/hwbinder
    symlink /dev/vndbinder /dev/binderfs/vndbinder

    # Create bootdevice symlinks immediately during early init
    wait /dev/block/platform/13500000.dwmmc0 5
    symlink /dev/block/platform/13500000.dwmmc0 /dev/block/bootdevice
    symlink /dev/block/platform/13500000.dwmmc0/by-name /dev/block/bootdevice/by-name

    symlink /dev/block/bootdevice/by-name/BOOT /dev/block/bootdevice/by-name/boot
    symlink /dev/block/bootdevice/by-name/RECOVERY /dev/block/bootdevice/by-name/recovery
    symlink /dev/block/bootdevice/by-name/SYSTEM /dev/block/bootdevice/by-name/system
    symlink /dev/block/bootdevice/by-name/VENDOR /dev/block/bootdevice/by-name/vendor
    symlink /dev/block/bootdevice/by-name/CACHE /dev/block/bootdevice/by-name/cache
    symlink /dev/block/bootdevice/by-name/RADIO /dev/block/bootdevice/by-name/modem
    symlink /dev/block/bootdevice/by-name/EFS /dev/block/bootdevice/by-name/efs
    symlink /dev/block/bootdevice/by-name/CPEFS /dev/block/bootdevice/by-name/cpefs
    symlink /dev/block/bootdevice/by-name/UP_PARAM /dev/block/bootdevice/by-name/up_param
    symlink /dev/block/bootdevice/by-name/DTBO /dev/block/bootdevice/by-name/dtbo
    symlink /dev/block/bootdevice/by-name/PRODUCT /dev/block/bootdevice/by-name/product
    symlink /dev/block/bootdevice/by-name/USERDATA /dev/block/bootdevice/by-name/userdata
    symlink /dev/block/bootdevice/by-name/USERDATA /dev/block/bootdevice/by-name/data

on fs
    wait /dev/block/platform/13500000.dwmmc0 5
    symlink /dev/block/platform/13500000.dwmmc0 /dev/block/bootdevice
    symlink /dev/block/platform/13500000.dwmmc0/by-name /dev/block/bootdevice/by-name

    # Pre-create /sdcard/Fox/FoxFiles to eliminate "OrangeFox can't access its files" hint
    mkdir /data 0771 system system
    mkdir /data/media 0775 media_rw media_rw
    mkdir /data/media/0 0775 media_rw media_rw
    mount tmpfs tmpfs /data/media/0
    mkdir /data/media/0/Fox 0775 media_rw media_rw
    mkdir /data/media/0/Fox/FoxFiles 0775 media_rw media_rw

on boot
    setprop sys.usb.config adb
    setprop persist.sys.usb.config adb
    setprop service.adb.root 1
    start adbd
    # Flashlight (S2MU004 Camera Flash)
    chmod 0666 /sys/class/camera/flash/rear_flash
    chmod 0666 /sys/devices/virtual/camera/flash/rear_flash
    chmod 0666 /sys/class/leds/flashlight/brightness

    # Virtual Input & Graphics (scrcpy & container input)
    chmod 0666 /dev/uinput
    chmod 0666 /dev/graphics/fb0

    # Wi-Fi / rfkill
    chmod 0666 /sys/class/rfkill/rfkill0/state

    # CPU governor performance boost (prevents 10s decryption timeout)
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu5/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu6/cpufreq/scaling_governor performance
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor performance
