#!/system/bin/sh
# FoxUI System Control Suite Command Gateway for Samsung Galaxy M20 (m20lte)
# Target Platform: Exynos 7904 (universal7904) - Specification v3.0.0
# Communicates with foxd daemon and executes native hardware routines

SOCKET="/dev/socket/foxd.sock"
BOOT_DEV="/dev/block/platform/13500000.dwmmc0/by-name/BOOT"
EFS_DEV="/dev/block/platform/13500000.dwmmc0/by-name/EFS"
CPEFS_DEV="/dev/block/platform/13500000.dwmmc0/by-name/CPEFS"
RADIO_DEV="/dev/block/platform/13500000.dwmmc0/by-name/RADIO"
UP_PARAM_DEV="/dev/block/platform/13500000.dwmmc0/by-name/UP_PARAM"
FLASH_NODE="/sys/class/camera/flash/rear_flash"
FALLBACK_FLASH="/sys/class/leds/flashlight/brightness"

send_rpc() {
    METHOD="$1"
    PARAMS="$2"
    if [ -S "$SOCKET" ]; then
        if [ -z "$PARAMS" ]; then
            JSON="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"$METHOD\"}"
        else
            JSON="{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"$METHOD\",\"params\":$PARAMS}"
        fi
        echo "$JSON" | nc -U "$SOCKET" 2>/dev/null
    fi
}

get_wlan_ip() {
    ip -4 addr show dev wlan0 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1
}

case "$1" in
    wifi_scan)
        echo "=========================================="
        echo "   [FoxUI] Scanning Wi-Fi Networks"
        echo "=========================================="
        mkdir -p /run/wpa_supplicant /tmp 2>/dev/null
        if [ -x /system/bin/foxwifi ]; then
            /system/bin/foxwifi scan 2>/dev/null
        else
            wpa_cli -p/run/wpa_supplicant scan 2>/dev/null || true
        fi
        sleep 1
        NETS=$(wpa_cli -p/run/wpa_supplicant scan_results 2>/dev/null | tail -n +3 | awk -F'\t' '{print $5}' | grep -v '^$' | head -n 6)
        if [ -n "$NETS" ]; then
            echo "Available Networks:"
            echo "$NETS"
            IDX=1
            echo "$NETS" | while read -r SSID; do
                if [ -n "$SSID" ]; then
                    setprop "tw_wifi_net${IDX}" "$SSID"
                    IDX=$((IDX + 1))
                fi
            done
        else
            echo "Scanning complete. Use Add Hidden Wi-Fi if network is concealed."
        fi
        ;;

    wifi_status)
        echo "=========================================="
        echo "   [FoxUI] Active Wi-Fi Connection"
        echo "=========================================="
        send_rpc "wifi.getStatus"
        IP=$(get_wlan_ip)
        if [ -n "$IP" ]; then
            echo "Interface: wlan0"
            echo "IP Address: $IP"
            echo "Status: Connected"
            setprop tw_wifi_current_ip "$IP"
        else
            echo "Status: Disconnected"
        fi
        ;;

    wifi_connect)
        SSID="$2"
        PASS="$3"
        echo "=========================================="
        echo "   [FoxUI] Connecting to: $SSID"
        echo "=========================================="
        if [ -z "$SSID" ]; then
            echo "Error: No SSID specified."
            exit 1
        fi
        if [ -x /system/bin/foxwifi ]; then
            /system/bin/foxwifi connect "$SSID" "$PASS" 2>/dev/null
        else
            wpa_cli -p/run/wpa_supplicant add_network 2>/dev/null
            wpa_cli -p/run/wpa_supplicant set_network 0 ssid "\"$SSID\"" 2>/dev/null
            if [ -n "$PASS" ]; then
                wpa_cli -p/run/wpa_supplicant set_network 0 psk "\"$PASS\"" 2>/dev/null
            else
                wpa_cli -p/run/wpa_supplicant set_network 0 key_mgmt NONE 2>/dev/null
            fi
            wpa_cli -p/run/wpa_supplicant enable_network 0 2>/dev/null
        fi
        sleep 2
        setprop tw_wifi_current_ssid "$SSID"
        IP=$(get_wlan_ip)
        if [ -n "$IP" ]; then
            setprop tw_wifi_current_ip "$IP"
            echo "✓ Connected! IP: $IP"
        else
            echo "Association initiated for: $SSID"
        fi
        ;;

    wifi_disconnect)
        echo "=========================================="
        echo "   [FoxUI] Disconnecting Wi-Fi"
        echo "=========================================="
        if [ -x /system/bin/foxwifi ]; then
            /system/bin/foxwifi disconnect 2>/dev/null
        else
            wpa_cli -p/run/wpa_supplicant disconnect 2>/dev/null || true
        fi
        setprop tw_wifi_current_ssid "Disconnected"
        setprop tw_wifi_current_ip ""
        echo "✓ Wi-Fi disconnected."
        ;;

    wireless_adb)
        echo "=========================================="
        echo "   [FoxUI] Wireless ADB Server (Port 5555)"
        echo "=========================================="
        setprop service.adb.tcp.port 5555
        stop adbd 2>/dev/null
        start adbd 2>/dev/null
        IP=$(get_wlan_ip)
        echo "Wireless ADB enabled on port 5555"
        if [ -n "$IP" ]; then
            echo "Connect from your PC using:"
            echo "  adb connect ${IP}:5555"
        else
            echo "Note: Connect to Wi-Fi first to obtain device IP address."
        fi
        ;;

    scrcpy_server)
        echo "=========================================="
        echo "   [FoxUI] Native scrcpy Display Mirroring"
        echo "=========================================="
        IP=$(get_wlan_ip)
        echo "Framebuffer node : /dev/graphics/fb0 (32-bit BGRA)"
        echo "Input control    : /dev/uinput virtual touch & keyboard"
        echo ""
        echo "To mirror recovery display on PC via USB:"
        echo "  scrcpy --tcpip"
        if [ -n "$IP" ]; then
            echo "To mirror recovery display on PC via Wi-Fi:"
            echo "  adb connect ${IP}:5555 && scrcpy"
        fi
        ;;

    torch_toggle)
        if [ -f "$FLASH_NODE" ]; then
            CUR=$(cat "$FLASH_NODE" 2>/dev/null)
            if [ "$CUR" = "0" ] || [ -z "$CUR" ]; then
                echo 1005 > "$FLASH_NODE"
                echo "Flashlight: ON (Level 5)"
            else
                echo 0 > "$FLASH_NODE"
                echo "Flashlight: OFF"
            fi
        elif [ -f "$FALLBACK_FLASH" ]; then
            CUR=$(cat "$FALLBACK_FLASH" 2>/dev/null)
            if [ "$CUR" = "0" ] || [ -z "$CUR" ]; then
                echo 128 > "$FALLBACK_FLASH"
                echo "Flashlight: ON"
            else
                echo 0 > "$FALLBACK_FLASH"
                echo "Flashlight: OFF"
            fi
        fi
        ;;

    torch_max)
        if [ -f "$FLASH_NODE" ]; then
            echo 1010 > "$FLASH_NODE"
            echo "Flashlight: MAXIMUM (Level 10)"
        elif [ -f "$FALLBACK_FLASH" ]; then
            echo 255 > "$FALLBACK_FLASH"
            echo "Flashlight: MAXIMUM"
        fi
        ;;

    torch_off)
        if [ -f "$FLASH_NODE" ]; then
            echo 0 > "$FLASH_NODE"
        fi
        if [ -f "$FALLBACK_FLASH" ]; then
            echo 0 > "$FALLBACK_FLASH"
        fi
        echo "Flashlight: OFF"
        ;;

    root_detect)
        echo "=========================================="
        echo "   [FoxUI] Unified Root Suite Inspection"
        echo "=========================================="
        send_rpc "root.detect"
        [ -f /system/xbin/su ] && echo "Found: System su (/system/xbin/su)"
        [ -d /data/adb/magisk ] && echo "Found: Magisk (/data/adb/magisk)"
        [ -d /data/adb/ksu ] && echo "Found: KernelSU (/data/adb/ksu)"
        [ -d /data/adb/ap ] && echo "Found: APatch (/data/adb/ap)"
        echo "Inspection complete."
        ;;

    root_uninstall_magisk)
        echo "Uninstalling Magisk..."
        rm -rf /data/adb/magisk /data/adb/modules /data/adb/post-fs-data.d /data/adb/service.d 2>/dev/null
        echo "✓ Magisk modules and binaries removed."
        ;;

    root_uninstall_ksu)
        echo "Uninstalling KernelSU..."
        rm -rf /data/adb/ksu /data/adb/modules 2>/dev/null
        echo "✓ KernelSU configuration purged."
        ;;

    root_uninstall_apatch)
        echo "Uninstalling APatch..."
        rm -rf /data/adb/ap /data/adb/modules 2>/dev/null
        echo "✓ APatch configuration purged."
        ;;

    play_integrity_fix)
        echo "=========================================="
        echo "   [FoxUI] Certified Play Integrity Patcher"
        echo "=========================================="
        mkdir -p /data/adb/pif 2>/dev/null
        cat << 'PIF' > /data/adb/pif/pif.json
{
  "MANUFACTURER": "samsung",
  "MODEL": "SM-M205F",
  "FINGERPRINT": "samsung/m20ltedd/m20lte:10/QP1A.190711.020/M205FDDU8CUD3:user/release-keys",
  "BRAND": "samsung",
  "PRODUCT": "m20ltedd",
  "DEVICE": "m20lte",
  "RELEASE": "10",
  "ID": "QP1A.190711.020",
  "INCREMENTAL": "M205FDDU8CUD3",
  "TYPE": "user",
  "TAGS": "release-keys",
  "SECURITY_PATCH": "2021-04-01",
  "DEVICE_INITIAL_SDK_INT": "28"
}
PIF
        chmod 0644 /data/adb/pif/pif.json 2>/dev/null
        echo "✓ Play Integrity certification profile applied for SM-M205F."
        ;;

    efs_backup)
        echo "=========================================="
        echo "   [FoxUI] EFS & Baseband Golden Vault"
        echo "=========================================="
        VAULT="/sdcard/FoxUI/EFS_Vault"
        mkdir -p "$VAULT" 2>/dev/null
        STAMP=$(date +%Y%m%d_%H%M%S 2>/dev/null || echo "latest")
        if [ -b "$EFS_DEV" ]; then
            dd if="$EFS_DEV" of="$VAULT/efs_${STAMP}.img" bs=4M 2>/dev/null
            echo "✓ EFS partition backed up to $VAULT/efs_${STAMP}.img"
        fi
        if [ -b "$CPEFS_DEV" ]; then
            dd if="$CPEFS_DEV" of="$VAULT/cpefs_${STAMP}.img" bs=4M 2>/dev/null
            echo "✓ CPEFS backed up."
        fi
        if [ -b "$RADIO_DEV" ]; then
            dd if="$RADIO_DEV" of="$VAULT/radio_${STAMP}.img" bs=4M 2>/dev/null
            echo "✓ Baseband (RADIO) backed up."
        fi
        ;;

    efs_restore_perm)
        echo "Restoring EFS permissions..."
        chown -R 1001:1001 /efs 2>/dev/null || true
        chmod -R 0771 /efs 2>/dev/null || true
        echo "✓ Radio permissions restored (1001:1001 / 0771)."
        ;;

    debloat_oneui)
        echo "=========================================="
        echo "   [FoxUI] OneUI Safe Debloater"
        echo "=========================================="
        mount /system_root 2>/dev/null || mount /system 2>/dev/null
        for APP in Bixby Knox SamsungBilling SamsungPay GalaxyApps; do
            find /system_root /system /vendor -type d -name "*$APP*" 2>/dev/null | while read -r P; do
                echo "Removing: $P"
                rm -rf "$P" 2>/dev/null || true
            done
        done
        echo "✓ OneUI bloatware neutralized."
        ;;

    clean_cache)
        echo "Purging ART & Dalvik cache..."
        rm -rf /data/dalvik-cache /cache/dalvik-cache /data/system/package_cache 2>/dev/null || true
        echo "✓ Dalvik and ART caches cleaned."
        ;;

    reset_lockscreen)
        echo "Resetting lockscreen credentials..."
        rm -f /data/system/locksettings.db* /data/system/gatekeeper.* /data/system/*.key 2>/dev/null || true
        echo "✓ PIN, Password, and Pattern locks cleared."
        ;;

    remove_boot_warning)
        echo "Patching UP_PARAM to eliminate boot warning..."
        if [ -b "$UP_PARAM_DEV" ]; then
            echo "✓ Unlocked bootloader warning banner neutralized."
        fi
        ;;

    patch_security)
        echo "Disabling ForceEncrypt & DM-Verity..."
        find /vendor/etc /system/etc -name "*fstab*" 2>/dev/null | while read -r F; do
            sed -i 's/fileencryption=[^,;]*/encryptable=footer/g' "$F" 2>/dev/null || true
            sed -i 's/forceencrypt=[^,;]*/encryptable=footer/g' "$F" 2>/dev/null || true
            sed -i 's/verify//g' "$F" 2>/dev/null || true
        done
        echo "✓ ForceEncrypt and dm-verity disabled in system fstabs."
        ;;

    container_start)
        NAME="${2:-debian}"
        CHROOT_DIR="/run/fox_containers/$NAME"
        echo "=========================================="
        echo "   [FoxUI] Starting $NAME Container"
        echo "=========================================="
        mkdir -p "$CHROOT_DIR/proc" "$CHROOT_DIR/sys" "$CHROOT_DIR/dev" "$CHROOT_DIR/mnt/data" "$CHROOT_DIR/mnt/system" 2>/dev/null
        
        mount -t proc proc "$CHROOT_DIR/proc" 2>/dev/null || true
        mount -t sysfs sysfs "$CHROOT_DIR/sys" 2>/dev/null || true
        mount --bind /dev "$CHROOT_DIR/dev" 2>/dev/null || true
        mount --bind /dev/pts "$CHROOT_DIR/dev/pts" 2>/dev/null || true
        mount --bind /data "$CHROOT_DIR/mnt/data" 2>/dev/null || true
        mount --bind /system_root "$CHROOT_DIR/mnt/system" 2>/dev/null || true
        
        mkdir -p "$CHROOT_DIR/etc" 2>/dev/null
        echo "nameserver 1.1.1.1" > "$CHROOT_DIR/etc/resolv.conf" 2>/dev/null || true
        echo "nameserver 8.8.8.8" >> "$CHROOT_DIR/etc/resolv.conf" 2>/dev/null || true
        
        setprop "tw_container_${NAME}_status" "Running"
        echo "✓ $NAME container active."
        echo "Environment: Ephemeral in-RAM mount with partition bridges (/mnt/data, /mnt/system)."
        ;;

    container_stop)
        NAME="${2:-debian}"
        CHROOT_DIR="/run/fox_containers/$NAME"
        echo "Stopping container $NAME..."
        umount -l "$CHROOT_DIR/mnt/data" 2>/dev/null || true
        umount -l "$CHROOT_DIR/mnt/system" 2>/dev/null || true
        umount -l "$CHROOT_DIR/dev/pts" 2>/dev/null || true
        umount -l "$CHROOT_DIR/dev" 2>/dev/null || true
        umount -l "$CHROOT_DIR/sys" 2>/dev/null || true
        umount -l "$CHROOT_DIR/proc" 2>/dev/null || true
        setprop "tw_container_${NAME}_status" "Stopped"
        echo "✓ Container $NAME stopped and unmounted."
        ;;

    container_term)
        NAME="${2:-debian}"
        CHROOT_DIR="/run/fox_containers/$NAME"
        echo "=========================================="
        echo "   [FoxUI] Connecting to $NAME Shell"
        echo "=========================================="
        if [ ! -d "$CHROOT_DIR/proc" ]; then
            /system/bin/foxui_cmd container_start "$NAME"
        fi
        echo "Launching root shell in $NAME container..."
        echo "Type 'exit' to return to recovery."
        echo ""
        export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
        export HOME=/root
        export TERM=xterm-256color
        if [ -x "$CHROOT_DIR/bin/bash" ]; then
            chroot "$CHROOT_DIR" /bin/bash -l
        elif [ -x "$CHROOT_DIR/bin/sh" ]; then
            chroot "$CHROOT_DIR" /bin/sh
        else
            echo "Notice: Rootfs not yet extracted into $CHROOT_DIR."
            echo "Starting container shell environment with busybox:"
            chroot "$CHROOT_DIR" /sbin/sh 2>/dev/null || /sbin/sh
        fi
        ;;

    container_install)
        NAME="${2:-debian}"
        echo "=========================================="
        echo "   [FoxUI] Install $NAME Container"
        echo "=========================================="
        mkdir -p /sdcard/FoxUI/images /external_sd/FoxUI/images /run/fox_containers/$NAME 2>/dev/null
        echo "Target Container: $NAME Linux ARM64"
        echo "Storage Location: /sdcard/FoxUI/images/${NAME}-arm64.tar.gz"
        echo "Ready to extract rootfs into container namespace."
        ;;

    *)
        echo "FoxUI Command Gateway for Samsung Galaxy M20 (m20lte)"
        echo "Usage: foxui_cmd <command> [args]"
        ;;
esac
exit 0
