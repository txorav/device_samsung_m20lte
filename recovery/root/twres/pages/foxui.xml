				<text>%tw_wifi_hidden_pass_mask%</text>
				<restrict minlen="0" maxlen="64"/>
				<action function="set">tw_back=foxui_wifi</action>
				<action function="set">tw_action=terminalcommand</action>
				<action function="set">tw_action_param=/system/bin/foxui_cmd wifi_connect "%tw_wifi_hidden_ssid%" "%tw_wifi_hidden_pass%"</action>
				<action function="page">action_page</action>
			</input>

			<template name="keyboardtemplate"/>
			<template name="gestures_key"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">foxui_wifi_hidden_ssid</action>
			</action>
		</page>

