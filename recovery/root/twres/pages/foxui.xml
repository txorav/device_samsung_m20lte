				</listitem>
				<listitem name="Maximum Torch (Level 10 / 250 mA)">
					<icon res="bolt"/>
					<action function="set">tw_back=foxui_torch</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd torch_max</action>
					<action function="set">tw_action_text1=Max Flashlight</action>
					<action function="set">tw_action_text2=Setting maximum brightness...</action>
					<action function="set">tw_complete_text1=Max Torch Active</action>
					<action function="page">action_page</action>
				</listitem>
				<listitem name="Turn Flashlight OFF">
					<icon res="delete"/>
					<action function="set">tw_back=foxui_torch</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd torch_off</action>
					<action function="set">tw_action_text1=Flashlight OFF</action>
					<action function="set">tw_action_text2=Extinguishing rear flash...</action>
					<action function="set">tw_complete_text1=Flashlight OFF</action>
					<action function="page">action_page</action>
				</listitem>
			</listbox>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">foxui_dashboard</action>
			</action>
		</page>

