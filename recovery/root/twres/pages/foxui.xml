				</listitem>
				<listitem name="Connect to Debian Terminal">
					<icon res="edit"/>
					<action function="set">tw_back=foxui_containers</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd container_term debian</action>
					<action function="page">action_page</action>
				</listitem>
				<listitem name="Stop Debian Container">
					<icon res="delete"/>
					<action function="set">tw_back=foxui_containers</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd container_stop debian</action>
					<action function="page">action_page</action>
				</listitem>

				<!-- Alpine Linux Container -->
				<listitem name="Start Alpine Minimal Rescue Container">
					<icon res="cube"/>
					<action function="set">tw_back=foxui_containers</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd container_start alpine</action>
					<action function="page">action_page</action>
				</listitem>
				<listitem name="Connect to Alpine Terminal">
					<icon res="edit"/>
					<action function="set">tw_back=foxui_containers</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd container_term alpine</action>
					<action function="page">action_page</action>
				</listitem>
				<listitem name="Stop Alpine Container">
					<icon res="delete"/>
					<action function="set">tw_back=foxui_containers</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd container_stop alpine</action>
					<action function="page">action_page</action>
				</listitem>

				<!-- Arch Linux ARM Container -->
				<listitem name="Start Arch Linux ARM Container">
					<icon res="cube"/>
					<action function="set">tw_back=foxui_containers</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd container_start arch</action>
					<action function="page">action_page</action>
				</listitem>
				<listitem name="Connect to Arch Terminal">
					<icon res="edit"/>
					<action function="set">tw_back=foxui_containers</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd container_term arch</action>
					<action function="page">action_page</action>
				</listitem>
				<listitem name="Stop Arch Container">
					<icon res="delete"/>
					<action function="set">tw_back=foxui_containers</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd container_stop arch</action>
					<action function="page">action_page</action>
				</listitem>

				<!-- Container Installer -->
				<listitem name="Download &amp; Install Rootfs Packages">
					<icon res="addons"/>
					<action function="set">tw_back=foxui_containers</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd container_install debian</action>
					<action function="page">action_page</action>
				</listitem>
			</listbox>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">foxui_dashboard</action>
			</action>
		</page>

