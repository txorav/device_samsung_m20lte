<?xml version="1.0"?>
<recovery>
	<pages>
		<!-- FoxUI System Control Suite Main Dashboard -->
		<page name="foxui_dashboard">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>FoxUI System Suite</text>
			</text>

			<listbox style="group_list">
				<placement x="0" y="%ab_h%" w="%screen_w%" h="%files_np_w%"/>
				<listitem name="Wi-Fi Network Manager">
					<icon res="open_in_browser"/>
					<action function="page">foxui_wifi</action>
				</listitem>
				<listitem name="Wireless ADB &amp; scrcpy Server">
					<icon res="devices"/>
					<action function="page">foxui_adb</action>
				</listitem>
				<listitem name="S2MU004 Flashlight HAL">
					<icon res="bolt"/>
					<action function="page">foxui_torch</action>
				</listitem>
				<listitem name="Unified Root Management Suite">
					<icon res="shield_toggle"/>
					<action function="page">foxui_root</action>
				</listitem>
				<listitem name="EFS &amp; Baseband Golden Vault">
					<icon res="backup"/>
					<action function="page">foxui_efs</action>
				</listitem>
				<listitem name="OneUI Debloater &amp; Cleaner">
					<icon res="mobile_wrench"/>
					<action function="page">foxui_debloat</action>
				</listitem>
				<listitem name="In-RAM Linux Containers">
					<icon res="cube"/>
					<action function="page">foxui_container</action>
				</listitem>
				<listitem name="Samsung Security &amp; Boot Patcher">
					<icon res="chip"/>
					<action function="page">foxui_patcher</action>
				</listitem>
			</listbox>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">advanced</action>
			</action>
		</page>

		<!-- Subpage: Wi-Fi Management -->
		<page name="foxui_wifi">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Wi-Fi Management</text>
			</text>

			<listbox style="group_list">
				<placement x="0" y="%ab_h%" w="%screen_w%" h="%files_np_w%"/>
				<listitem name="Scan Wireless Networks">
					<icon res="devices"/>
					<action function="set">tw_back=foxui_wifi</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd wifi_scan</action>
					<action function="set">tw_action_text1=Wi-Fi Scan</action>
					<action function="set">tw_action_text2=Scanning wireless channels...</action>
					<action function="set">tw_complete_text1=Scan Complete</action>
					<action function="page">action_page</action>
				</listitem>
				<listitem name="Connection Status &amp; IP">
					<icon res="info"/>
					<action function="set">tw_back=foxui_wifi</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd wifi_status</action>
					<action function="set">tw_action_text1=Wi-Fi Status</action>
					<action function="set">tw_action_text2=Querying network state...</action>
					<action function="set">tw_complete_text1=Status Retrieved</action>
					<action function="page">action_page</action>
				</listitem>
				<listitem name="Disconnect Wi-Fi">
					<icon res="delete"/>
					<action function="set">tw_back=foxui_wifi</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd wifi_disconnect</action>
					<action function="set">tw_action_text1=Wi-Fi Disconnect</action>
					<action function="set">tw_action_text2=Releasing wireless connection...</action>
					<action function="set">tw_complete_text1=Disconnected</action>
					<action function="page">action_page</action>
				</listitem>
			</listbox>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">foxui_dashboard</action>
			</action>
		</page>

		<!-- Subpage: Wireless ADB & scrcpy -->
		<page name="foxui_adb">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Wireless ADB &amp; scrcpy</text>
			</text>

			<listbox style="group_list">
				<placement x="0" y="%ab_h%" w="%screen_w%" h="%files_np_w%"/>
				<listitem name="Start Wireless ADB (Port 5555)">
					<icon res="devices"/>
					<action function="set">tw_back=foxui_adb</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd wireless_adb</action>
					<action function="set">tw_action_text1=Wireless ADB</action>
					<action function="set">tw_action_text2=Starting TCP daemon on port 5555...</action>
					<action function="set">tw_complete_text1=Wireless ADB Active</action>
					<action function="page">action_page</action>
				</listitem>
				<listitem name="Native scrcpy Screen Mirror Info">
					<icon res="mobile"/>
					<action function="set">tw_back=foxui_adb</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd scrcpy_server</action>
					<action function="set">tw_action_text1=Recovery scrcpy</action>
					<action function="set">tw_action_text2=Querying scrcpy server status...</action>
					<action function="set">tw_complete_text1=Ready for PC Connection</action>
					<action function="page">action_page</action>
				</listitem>
			</listbox>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">foxui_dashboard</action>
			</action>
		</page>

		<!-- Subpage: S2MU004 Flashlight HAL -->
		<page name="foxui_torch">
			<template name="base"/>

