<?xml version="1.0"?>
<recovery>
	<pages>
		<!-- FoxUI System Control Suite Main Dashboard -->
		<page name="foxui_dashboard">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>FoxUI System Suite</text>
			</text>

			<listbox style="group_list">
				<placement x="0" y="%ab_h%" w="%screen_w%" h="%files_np_w%"/>
				<listitem name="Wi-Fi Network Manager">
					<icon res="open_in_browser"/>
					<action function="page">foxui_wifi</action>
				</listitem>
				<listitem name="In-RAM Linux Containers">
					<icon res="cube"/>
					<action function="page">foxui_containers</action>
				</listitem>
				<listitem name="Wireless ADB &amp; scrcpy Server">
					<icon res="devices"/>
					<action function="page">foxui_adb</action>
				</listitem>
				<listitem name="S2MU004 Flashlight HAL">
					<icon res="bolt"/>
					<action function="page">foxui_torch</action>
				</listitem>
				<listitem name="Unified Root Management Suite">
					<icon res="shield_toggle"/>
					<action function="page">foxui_root</action>
				</listitem>
				<listitem name="EFS &amp; Baseband Golden Vault">
					<icon res="backup"/>
					<action function="page">foxui_efs</action>
				</listitem>
				<listitem name="OneUI Debloater &amp; Cleaner">
					<icon res="mobile_wrench"/>
					<action function="page">foxui_debloat</action>
				</listitem>
				<listitem name="Samsung Security &amp; Boot Patcher">
					<icon res="chip"/>
					<action function="page">foxui_patcher</action>
				</listitem>
			</listbox>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">advanced</action>
			</action>
		</page>

		<!-- Subpage: Wi-Fi Management Touch GUI -->
		<page name="foxui_wifi">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Wi-Fi Network Manager</text>
			</text>

			<listbox style="group_list">
				<placement x="0" y="%ab_h%" w="%screen_w%" h="%files_np_w%"/>
				<listitem name="Scan Available Networks">
					<icon res="devices"/>
					<action function="set">tw_back=foxui_wifi</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd wifi_scan</action>
					<action function="set">tw_action_text1=Scanning Wi-Fi...</action>
					<action function="page">action_page</action>
				</listitem>
				<listitem name="Connect to Wi-Fi Network 1">
					<icon res="edit"/>
					<action function="set">tw_wifi_target=%tw_wifi_net1%</action>
					<action function="page">foxui_wifi_pass</action>
				</listitem>
				<listitem name="Connect to Wi-Fi Network 2">
					<icon res="edit"/>
					<action function="set">tw_wifi_target=%tw_wifi_net2%</action>
					<action function="page">foxui_wifi_pass</action>
				</listitem>
				<listitem name="Connect to Wi-Fi Network 3">
					<icon res="edit"/>
					<action function="set">tw_wifi_target=%tw_wifi_net3%</action>
					<action function="page">foxui_wifi_pass</action>
				</listitem>
				<listitem name="Add Hidden Wi-Fi Network">
					<icon res="addons"/>
					<action function="page">foxui_wifi_hidden_ssid</action>
				</listitem>
				<listitem name="Check Connection Status &amp; IP">
					<icon res="info"/>
					<action function="set">tw_back=foxui_wifi</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd wifi_status</action>
					<action function="page">action_page</action>
				</listitem>
				<listitem name="Disconnect Active Wi-Fi">
					<icon res="delete"/>
					<action function="set">tw_back=foxui_wifi</action>
					<action function="set">tw_action=terminalcommand</action>
					<action function="set">tw_action_param=/system/bin/foxui_cmd wifi_disconnect</action>
					<action function="page">action_page</action>
				</listitem>
			</listbox>

			<template name="gestures"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">foxui_dashboard</action>
			</action>
		</page>

		<!-- Subpage: Enter Wi-Fi Password with Keyboard -->
		<page name="foxui_wifi_pass">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Wi-Fi Password</text>
			</text>

			<text style="text_body2">
				<placement x="%col1_x_caption%" y="%row1_1_y%"/>
				<text>Enter password for network:</text>
			</text>

			<input>
				<placement x="%col1_x_caption%" y="%row1_2_y%" w="%input_w%" h="%input_height%"/>
				<data name="tw_wifi_password" mask="*" maskvariable="tw_wifi_password_mask"/>
				<text>%tw_wifi_password_mask%</text>
				<restrict minlen="0" maxlen="64"/>
				<action function="set">tw_back=foxui_wifi</action>
				<action function="set">tw_action=terminalcommand</action>
				<action function="set">tw_action_param=/system/bin/foxui_cmd wifi_connect "%tw_wifi_target%" "%tw_wifi_password%"</action>
				<action function="page">action_page</action>
			</input>

			<template name="keyboardtemplate"/>
			<template name="gestures_key"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">foxui_wifi</action>
			</action>
		</page>

		<!-- Subpage: Add Hidden Wi-Fi (Step 1: SSID) -->
		<page name="foxui_wifi_hidden_ssid">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Add Hidden Wi-Fi</text>
			</text>

			<text style="text_body2">
				<placement x="%col1_x_caption%" y="%row1_1_y%"/>
				<text>Enter Hidden Network SSID:</text>
			</text>

			<input>
				<placement x="%col1_x_caption%" y="%row1_2_y%" w="%input_w%" h="%input_height%"/>
				<data name="tw_wifi_hidden_ssid"/>
				<text>%tw_wifi_hidden_ssid%</text>
				<restrict minlen="1" maxlen="32"/>
				<action function="page">foxui_wifi_hidden_pass</action>
			</input>

			<template name="keyboardtemplate"/>
			<template name="gestures_key"/>

			<action>
				<touch key="home"/>
				<action function="page">main</action>
			</action>

			<action>
				<touch key="back"/>
				<action function="page">foxui_wifi</action>
			</action>
		</page>

		<!-- Subpage: Add Hidden Wi-Fi (Step 2: Password) -->
		<page name="foxui_wifi_hidden_pass">
			<template name="base"/>

			<text style="text_ab_title">
				<placement x="%col1_x_indent%" y="%ab_bc_y%"/>
				<text>Hidden Wi-Fi Password</text>
			</text>

			<text style="text_body2">
				<placement x="%col1_x_caption%" y="%row1_1_y%"/>
				<text>Enter Password for %tw_wifi_hidden_ssid%:</text>
			</text>

			<input>
				<placement x="%col1_x_caption%" y="%row1_2_y%" w="%input_w%" h="%input_height%"/>
