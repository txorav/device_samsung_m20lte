{
  "schema_version": "3.0",
  "container_id": "alpine-rescue",
  "display_name": "Alpine Linux Minimal Rescue",
  "distro": "alpine-aarch64",
  "base_image_path": "/external_sd/FoxUI/images/alpine-arm64.sqfs",
  "storage_config": {
    "persistence_mode": "EPHEMERAL_RAM",
    "ram_upperdir_limit_mb": 512
  },
  "runtime_config": {
    "hostname": "m20lte-alpine",
    "init_command": ["/bin/sh"],
    "network_mode": "HOST",
    "ssh_port": 2222
  }
}
